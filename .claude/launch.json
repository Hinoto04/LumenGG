{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "play-dev",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "-u",
        "scripts/serve_play_dev.py",
        "--port",
        "8874"
      ],
      "port": 8874
    },
    {
      "name": "pyodide-lab",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "play/node_modules/vite/bin/vite.js",
        "--config",
        "play/vite.pyodide.config.ts"
      ],
      "port": 5176
    },
    {
      "name": "play-vite",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "play/node_modules/vite/bin/vite.js",
        "--config",
        "play/vite.config.ts",
        "play"
      ],
      "port": 5175
    }
  ]
}