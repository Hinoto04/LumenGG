{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rulebook-visual-translations.schema.json",
  "title": "LumenDB visual guide translations",
  "type": "object",
  "required": ["language", "translations"],
  "properties": {
    "$schema": { "type": "string" },
    "language": { "enum": ["en", "ja"] },
    "translations": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    }
  },
  "additionalProperties": false
}
